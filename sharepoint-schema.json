{
  "platform": "Microsoft SharePoint Online",
  "site": "https://worldbankgroup.sharepoint.com/sites/Dhaka-Mission-Management",
  "description": "SharePoint list schema for the WB Bangladesh Office Dhaka Mission Visitor Management Platform",
  "version": "1.0",
  "lists": [
    {
      "listName": "Mission_Registrations",
      "description": "Stores all mission visitor registration submissions",
      "columns": [
        {
          "name": "Title",
          "type": "Single line of text",
          "required": false,
          "note": "Rename to MissionTitle. Auto-set by Power Automate to WB-BD-[ID]"
        },
        {
          "name": "UPI_Number",
          "type": "Single line of text",
          "required": true,
          "note": "World Bank UPI identifier of the registrant"
        },
        {
          "name": "FullName",
          "type": "Single line of text",
          "required": true
        },
        {
          "name": "Email",
          "type": "Single line of text",
          "required": true
        },
        {
          "name": "ArrivalDate",
          "type": "Date and Time",
          "required": true,
          "dateOnly": true
        },
        {
          "name": "DepartureDate",
          "type": "Date and Time",
          "required": true,
          "dateOnly": true
        },
        {
          "name": "Accommodation",
          "type": "Choice",
          "required": true,
          "note": "Populated dynamically from Hotel_List via Power Apps dropdown"
        },
        {
          "name": "SecurityLearning",
          "type": "Choice",
          "required": true,
          "choices": [
            "Yes",
            "No"
          ]
        },
        {
          "name": "Purpose",
          "type": "Multiple lines of text",
          "required": true,
          "richText": false
        },
        {
          "name": "Comments",
          "type": "Multiple lines of text",
          "required": false,
          "richText": false
        },
        {
          "name": "SubmittedBy",
          "type": "Single line of text",
          "required": true,
          "note": "Auto-filled from Power Apps User().FullName"
        },
        {
          "name": "Status",
          "type": "Choice",
          "required": true,
          "choices": [
            "Pending/Waiting",
            "Approved/Clear",
            "Rejected"
          ],
          "default": "Pending/Waiting"
        },
        {
          "name": "RejectionReason",
          "type": "Single line of text",
          "required": false
        },
        {
          "name": "AdminNotes",
          "type": "Multiple lines of text",
          "required": false,
          "richText": false
        },
        {
          "name": "SubmittedOn",
          "type": "Date and Time",
          "required": false,
          "default": "[Today]"
        },
        {
          "name": "ConfirmationSentOn",
          "type": "Date and Time",
          "required": false
        },
        {
          "name": "UniqueToken",
          "type": "Single line of text",
          "required": false,
          "note": "GUID auto-generated by Power Automate on creation"
        },
        {
          "name": "PreviousStatus",
          "type": "Single line of text",
          "required": false,
          "note": "Used by Flow 2 to detect status changes and avoid duplicate emails"
        }
      ]
    },
    {
      "listName": "Daily_Cap_Settings",
      "description": "Stores per-date capacity limits and blocking settings",
      "columns": [
        {
          "name": "Title",
          "type": "Single line of text",
          "required": false,
          "note": "Auto-set to date string e.g. 2025-03-15"
        },
        {
          "name": "CapDate",
          "type": "Date and Time",
          "required": true,
          "dateOnly": true
        },
        {
          "name": "MissionCap",
          "type": "Number",
          "required": true,
          "default": 60,
          "note": "Daily visitor cap for this specific date"
        },
        {
          "name": "ConfirmedCount",
          "type": "Number",
          "required": false,
          "default": 0,
          "note": "Updated by Power Automate on each approval"
        },
        {
          "name": "IsBlocked",
          "type": "Yes/No",
          "required": false,
          "default": false
        },
        {
          "name": "BlockReason",
          "type": "Single line of text",
          "required": false,
          "note": "e.g. National Holiday, Office Event"
        },
        {
          "name": "OverrideNote",
          "type": "Multiple lines of text",
          "required": false
        },
        {
          "name": "PreviousCapLimit",
          "type": "Number",
          "required": false,
          "default": 60,
          "note": "Used by Flow 4 to detect cap increases and re-evaluate waitlist"
        }
      ]
    },
    {
      "listName": "Admin_Parameters",
      "description": "Global editable system parameters. Admin changes these from inside Power Apps.",
      "columns": [
        {
          "name": "Title",
          "type": "Single line of text",
          "required": true
        },
        {
          "name": "ParameterName",
          "type": "Single line of text",
          "required": true,
          "note": "Exact key used in Power Apps LookUp(). Do not change after setup."
        },
        {
          "name": "ParameterValue",
          "type": "Number",
          "required": true
        },
        {
          "name": "Description",
          "type": "Multiple lines of text",
          "required": false
        },
        {
          "name": "LastUpdatedBy",
          "type": "Single line of text",
          "required": false
        },
        {
          "name": "LastUpdatedOn",
          "type": "Date and Time",
          "required": false
        }
      ],
      "seedData": [
        {
          "Title": "Male Body Count",
          "ParameterName": "MaleBodyCount",
          "ParameterValue": 30,
          "Description": "Maximum male visitors allowed per day"
        },
        {
          "Title": "Mission Cap",
          "ParameterName": "MissionCap",
          "ParameterValue": 60,
          "Description": "Maximum total mission visitors allowed per day"
        }
      ]
    },
    {
      "listName": "Email_Templates",
      "description": "Stores editable email content. Admin edits from Power Apps admin panel. Power Automate fetches at send time.",
      "columns": [
        {
          "name": "Title",
          "type": "Single line of text",
          "required": false
        },
        {
          "name": "TemplateKey",
          "type": "Single line of text",
          "required": true,
          "note": "Unique identifier used in Power Automate filter. Never change after setup."
        },
        {
          "name": "TemplateName",
          "type": "Single line of text",
          "required": true,
          "note": "Friendly name shown in Power Apps admin panel"
        },
        {
          "name": "Subject",
          "type": "Single line of text",
          "required": true,
          "note": "Email subject line. Supports {{tokens}}."
        },
        {
          "name": "Body",
          "type": "Multiple lines of text",
          "required": true,
          "richText": true,
          "note": "Full HTML email body. Supports {{tokens}}. Edit from Power Apps admin panel only."
        },
        {
          "name": "LastUpdatedBy",
          "type": "Single line of text",
          "required": false
        },
        {
          "name": "LastUpdatedOn",
          "type": "Date and Time",
          "required": false
        }
      ],
      "seedData": [
        {
          "TemplateKey": "REGISTRATION_ACK",
          "TemplateName": "Registration Acknowledgement",
          "Subject": "Mission Registration Received — {{ReferenceNumber}}",
          "Body": "See /email-templates/REGISTRATION_ACK.html"
        },
        {
          "TemplateKey": "ADMIN_ALERT",
          "TemplateName": "New Registration Admin Alert",
          "Subject": "New Mission Registration — {{FullName}} | {{ArrivalDate}}",
          "Body": "See /email-templates/ADMIN_ALERT.html"
        },
        {
          "TemplateKey": "APPROVED",
          "TemplateName": "Approval Notification",
          "Subject": "Your Mission Registration is Approved — {{ReferenceNumber}}",
          "Body": "See /email-templates/APPROVED.html"
        },
        {
          "TemplateKey": "REJECTED",
          "TemplateName": "Rejection Notification",
          "Subject": "Mission Registration Update — {{ReferenceNumber}}",
          "Body": "See /email-templates/REJECTED.html"
        },
        {
          "TemplateKey": "DAILY_DIGEST",
          "TemplateName": "Daily Admin Digest",
          "Subject": "Mission Visitor Digest — {{Today}}",
          "Body": "See /email-templates/DAILY_DIGEST.html"
        }
      ],
      "availableTokens": [
        "{{FullName}}",
        "{{UPI}}",
        "{{ReferenceNumber}}",
        "{{Email}}",
        "{{ArrivalDate}}",
        "{{DepartureDate}}",
        "{{Accommodation}}",
        "{{SecurityLearning}}",
        "{{Purpose}}",
        "{{Status}}",
        "{{RejectionReason}}",
        "{{AdminPanelLink}}",
        "{{Today}}",
        "{{MissionCap}}",
        "{{ConfirmedCount}}",
        "{{VisitorTable}}"
      ]
    },
    {
      "listName": "Hotel_List",
      "description": "Accommodation options shown in the registration form dropdown. Admin manages from SharePoint directly.",
      "columns": [
        {
          "name": "Title",
          "type": "Single line of text",
          "required": false
        },
        {
          "name": "HotelName",
          "type": "Single line of text",
          "required": true
        },
        {
          "name": "Address",
          "type": "Single line of text",
          "required": false
        },
        {
          "name": "IsActive",
          "type": "Yes/No",
          "required": true,
          "default": true,
          "note": "Set to No to hide from dropdown without deleting history"
        }
      ],
      "seedData": [
        {
          "HotelName": "Radisson Blu Dhaka",
          "Address": "Dhaka Water Garden City",
          "IsActive": true
        },
        {
          "HotelName": "InterContinental Dhaka",
          "Address": "1 Minto Road",
          "IsActive": true
        },
        {
          "HotelName": "Pan Pacific Sonargaon",
          "Address": "107 Kazi Nazrul Islam Avenue",
          "IsActive": true
        },
        {
          "HotelName": "Le Méridien Dhaka",
          "Address": "79/A Commercial Area",
          "IsActive": true
        },
        {
          "HotelName": "Amari Dhaka",
          "Address": "Lake Shore Drive",
          "IsActive": true
        },
        {
          "HotelName": "Other (specify in comments)",
          "Address": "",
          "IsActive": true
        }
      ]
    },
    {
      "listName": "Admin_Users",
      "description": "Controls who can access the Power Apps admin panel. Checked on app load via OnStart.",
      "columns": [
        {
          "name": "Title",
          "type": "Single line of text",
          "required": false
        },
        {
          "name": "AdminEmail",
          "type": "Single line of text",
          "required": true,
          "note": "Must match WBG email exactly in lowercase"
        },
        {
          "name": "AdminName",
          "type": "Single line of text",
          "required": true
        },
        {
          "name": "IsActive",
          "type": "Yes/No",
          "required": true,
          "default": true,
          "note": "Set to No to revoke access without deleting the record"
        }
      ],
      "seedData": [
        {
          "AdminEmail": "admin1@worldbank.org",
          "AdminName": "Admin One",
          "IsActive": true,
          "note": "Replace with real admin email addresses before go-live"
        }
      ]
    },
    {
      "listName": "Waitlist_Queue",
      "description": "Tracks visitors in overflow queue when daily cap is full. Managed entirely by Power Automate.",
      "columns": [
        {
          "name": "Title",
          "type": "Single line of text",
          "required": false
        },
        {
          "name": "RegistrationID",
          "type": "Number",
          "required": true,
          "note": "ID from Mission_Registrations list"
        },
        {
          "name": "WaitlistDate",
          "type": "Date and Time",
          "required": true,
          "dateOnly": true
        },
        {
          "name": "QueuePosition",
          "type": "Number",
          "required": true,
          "note": "Lower number = higher priority. 1 = next to be promoted."
        },
        {
          "name": "RegistrantEmail",
          "type": "Single line of text",
          "required": true
        },
        {
          "name": "RegistrantName",
          "type": "Single line of text",
          "required": true
        },
        {
          "name": "NumberOfPeople",
          "type": "Number",
          "required": true
        },
        {
          "name": "PromotedOn",
          "type": "Date and Time",
          "required": false,
          "note": "Stamped by Power Automate when promoted to Approved/Clear"
        }
      ]
    }
  ]
}
